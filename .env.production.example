# Application
APP_NAME="FlytBase Knowledge Intelligence"
APP_ENV=production
LOG_LEVEL=INFO
DATASET_DIR=se-dataset

# Neo4j
NEO4J_URI=bolt://host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_real_password
NEO4J_DATABASE=neo4j
VECTOR_STORE=qdrant

# Qdrant
QDRANT_URL=http://host:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_agent_chunks

# Postgres (optional if SQLite fallback is preferred)
POSTGRES_DSN=postgresql://user:password@host:5432/kb_agent

# LLM / embeddings
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

COHERE_API_KEY=your_cohere_key
COHERE_EMBED_MODEL=embed-english-v3.0
EMBEDDING_DIM=1024

# Live docs relevant hosts
LIVE_DOCS_ALLOWED_HOSTS=docs.flytbase.com,releases.flytbase.com
LIVE_FETCH_TIMEOUT_SECONDS=12
LIVE_MAX_PAGES=6

# Retrieval tuning
GRAPH_TOP_K=10
VECTOR_TOP_K=8
EVIDENCE_TOP_K=8
